__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*

# A knowledge-graph build's output, at the repository root (`<builder>-out/`).
/*-out/

# Sigma's own runtime state when the kit runs its SDLC on itself; tracked design, plans and
# research are re-included (git cannot re-include under an excluded parent, hence `.sdlc/*`).
.sdlc/*
!.sdlc/design/
!.sdlc/changelog-fragments/
!.sdlc/plans/
.sdlc/plans/reconcile/
.sdlc/plans/triage/
.sdlc/plans/scope/
!.sdlc/research/
!.sdlc/acceptance/
!.sdlc/decisions/
!.sdlc/rulebook.json
.sdlc/decisions/_*
!.sdlc/evidence/
.sdlc/evidence/*
!.sdlc/evidence/453/
!.sdlc/evidence/453/goal433-attack.json

# Python build and virtual-environment trees.
.venv/
venv/
/build/
/dist/
*.egg-info/

# Local agent-host state (live worktrees, per-machine settings).
.claude/

# Secrets: never commit.
.env
.env.*
!.env.example

# Benchmark task set: an external task's tree is fetched at run time, never committed.
/evals/bench/tasks/ext-*/repo/
